# .env.example
# Copy this to .env and fill in your values
# .env is gitignored — NEVER commit your actual .env

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=your-local-dev-secret-key-change-this

# ── Encryption (BYO Twilio credential storage) ─────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key is used to encrypt/decrypt Twilio credentials stored in the database
# Keep this secret! If you lose it, stored credentials cannot be decrypted.
ENCRYPTION_KEY=your-fernet-encryption-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# For local dev, allow everything. Tighten in production.
CORS_ORIGINS=*

# ── Redis ─────────────────────────────────────────────────────────────────────
# When running with Docker Compose, the hostname is "redis" (service name)
# When running FastAPI directly (without Docker), use localhost
REDIS_URL=redis://redis:6379/0

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ── Azure Speech ──────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key

# ── Traefik (production only) ─────────────────────────────────────────────────
ACME_EMAIL=your-email@example.com
API_DOMAIN=api.yourdomain.com
DOCKER_HUB_USERNAME=yourdockerhubusername
